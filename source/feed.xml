---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"
  xmlns:excerpt="http://wordpress.org/export/1.2/excerpt/"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:wfw="http://wellformedweb.org/CommentAPI/"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:wp="http://wordpress.org/export/1.2/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    <language>en-US</language>
    <wp:wxr_version>1.2</wp:wxr_version>
    <wp:base_site_url>{{ site.url }}</wp:base_site_url>
    <wp:base_blog_url>{{ site.url }}</wp:base_blog_url>
    {% assign sorted_articles = site.articles | sort: 'date' | reverse %}
    {% for article in sorted_articles %}
      <item>
        <title>{{ article.title | xml_escape }}</title>
        <link>{{ article.url | prepend: site.baseurl | prepend: site.url }}</link>
        {% if article.date %}
        <pubDate>{{ article.date | date_to_rfc822 }}</pubDate>
        <wp:post_date><![CDATA[{{ article.date | date: "%Y-%m-%d %H:%M:%S" }}]]></wp:post_date>
        <wp:post_date_gmt><![CDATA[{{ article.date | date: "%Y-%m-%d %H:%M:%S" }}]]></wp:post_date_gmt>
        {% endif %}
        {% assign author_last = article['author-last'] %}
        {% if author_last %}
        {% assign contrib = site.data.contributors | where:"last", author_last | first %}
        {% if contrib %}
        <dc:creator><![CDATA[{{ contrib.first }} {{ contrib.last }}]]></dc:creator>
        {% else %}
        <dc:creator><![CDATA[{{ site.author }}]]></dc:creator>
        {% endif %}
        {% elsif article.author.name %}
        <dc:creator><![CDATA[{{ article.author.name }}]]></dc:creator>
        {% elsif article.author %}
        <dc:creator><![CDATA[{{ article.author }}]]></dc:creator>
        {% else %}
        <dc:creator><![CDATA[{{ site.author }}]]></dc:creator>
        {% endif %}
        <guid isPermaLink="false">{{ article.url | prepend: site.baseurl | prepend: site.url }}</guid>
        <description></description>
        <content:encoded><![CDATA[{{ article.content | render_liquid | markdownify | absolutify_images }}]]></content:encoded>
        <excerpt:encoded><![CDATA[{{ article.subhead | default: "" }}]]></excerpt:encoded>
        <wp:post_name><![CDATA[{{ article.slug }}]]></wp:post_name>
        <wp:status>publish</wp:status>
        <wp:post_type>post</wp:post_type>
        <wp:comment_status>closed</wp:comment_status>
        <wp:ping_status>closed</wp:ping_status>
        {% if article.issue %}
        <category domain="inquiry-issue" nicename="{{ article.issue }}"><![CDATA[{{ article.issue }}]]></category>
        {% endif %}
        {% for tag in article.tags %}
        <category domain="post_tag" nicename="{{ tag | slugify }}"><![CDATA[{{ tag }}]]></category>
        {% endfor %}
        {% if article.category %}
        <category domain="inquiry-section" nicename="{{ article.category | slugify }}"><![CDATA[{{ article.category }}]]></category>
        {% endif %}
        <category domain="category" nicename="inquiry"><![CDATA[Inquiry]]></category>
      </item>
    {% endfor %}
  </channel>
</rss>
